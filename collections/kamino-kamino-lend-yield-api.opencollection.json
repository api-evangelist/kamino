        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get KLend reserve borrow APY and staking APY history",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.kamino.finance/kamino-market/:marketPubkey/reserves/:reservePubkey/borrow-and-staking-apys/history",
            "params": [
              {
                "name": "marketPubkey",
                "value": "",
                "type": "path",
                "description": "Kamino Lend market public key"
              },
              {
                "name": "reservePubkey",
                "value": "",
                "type": "path",
                "description": "Kamino Lend reserve public key"
              },
              {
                "name": "env",
                "value": "",
                "type": "query",
                "description": "Solana cluster environment"
              },
              {
                "name": "start",
                "value": "",
                "type": "query",
                "description": "Date input (ISO 8601 string or epoch in ms)"
              },
              {
                "name": "end",
                "value": "",
                "type": "query",
                "description": "Date input (ISO 8601 string or epoch in ms)"
              }
            ]
          },
          "docs": "Get historical borrow interest APY and staking APY data for reserves that contain LST tokens with staking yield. Used for Multiply underlying APY calculations."
        },
        {
          "info": {
